#!/usr/bin/env bash
set -euo pipefail

if [ ! -t 0 ]; then
  echo "Run sync/setup --ical directly in a terminal."
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-calendar/venv"
python3 -m venv "$VENV"
"$VENV/bin/python" -m pip install -r "$SCRIPT_DIR/requirements-ical.txt"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m omarchy_calendar_sync.setup_ical
